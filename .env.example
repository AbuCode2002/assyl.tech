# ─── Public ───
NEXT_PUBLIC_SITE_URL=https://assyltech.kz

# ─── Database ───
# Leave empty for local development: an embedded PostgreSQL (PGlite) is stored in ./.data/pglite
# Production: a real PostgreSQL connection string
DATABASE_URL=
# PGLITE_DIR=./.data/pglite

# ─── Admin auth ───
# Long random string (e.g. `openssl rand -base64 48`). REQUIRED in production.
AUTH_SECRET=
# First admin account, created automatically on the first login attempt when no admins exist
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Analytics ───
# Salt for hashing visitor IPs (never stored in plain text)
ANALYTICS_SALT=

# ─── Telegram notifications about new leads ───
# Can also be configured in the admin panel → Настройки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
